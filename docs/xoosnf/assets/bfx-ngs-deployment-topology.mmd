graph TB
    User["User workstation"] -->|"xoos run --env aws_batch_bfx_ngs"| PL["pipeline_launcher"]

    subgraph AWS["AWS Account — us-west-2"]
        subgraph VPC["VPC 10.0.0.0/16"]
            subgraph AZ["us-west-2b"]
                Subnet["Subnet 10.0.0.0/24"]
            end
            IGW["Internet Gateway"]
        end

        subgraph DriverQ["Driver (on-demand)"]
            DQ["prod-standard-analysis-driver"]
            DCE["c7a.large CE"]
        end

        subgraph SpotCPU["CPU SPOT Queues"]
            Q1["...-c7a-large"]
            Q2["...-c7a-8xlarge"]
            Q3["...-c7a-16xlarge"]
        end

        subgraph SpotGPU["GPU SPOT Queues"]
            Q4["...-g6-16xlarge"]
            Q5["...-g5-8xlarge"]
            Q6["...-g7e-8xlarge"]
            Q7["...others"]
        end

        subgraph OnDemand["On-Demand Mirrors"]
            Q8["...-c7a-large-on-demand"]
            Q9["...-g6-16xlarge-on-demand"]
            Q10["...others"]
        end

        subgraph Storage["S3 Buckets"]
            DataBucket["prod-standard-analysis-*<br/>(pipeline data bucket)"]
            DataCatalog["prod-data-catalog-*<br/>(input data)"]
            ResourceCatalog["prod-resource-catalog-*<br/>(references)"]
            XSAWorkspace["xsa-workspace<br/>(shared workspace)"]
            XOOSResources["prod-xoos-resources-*"]
        end

        subgraph Monitoring["Monitoring"]
            SQS["SQS Queue"]
            CW["CloudWatch Events"]
        end

        subgraph IAMRoles["IAM Roles"]
            DriverRole["prod-standard-analysis-driver"]
            DataRole["prod-standard-analysis-data-all-access"]
            WorkerRole["prod-standard-analysis-batch-worker"]
        end
    end

    PL -->|"1. Upload configs to S3"| DataBucket
    PL -->|"2. Submit driver job"| DQ
    DQ -->|"3. Run Nextflow"| SpotCPU
    DQ -->|"3. Run Nextflow"| SpotGPU
    SpotCPU -->|"Read inputs"| DataCatalog
    SpotCPU -->|"Read references"| ResourceCatalog
    SpotCPU -->|"Write results"| DataBucket
    SpotGPU -->|"Read/Write"| DataBucket
    DQ -.->|"Job events"| CW
    SpotCPU -.->|"Job events"| CW
    CW -.->|"Forward"| SQS
