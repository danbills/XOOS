graph TD
    subgraph Input["Input Layer"]
        InputBAM[Input BAM]
        FASTA[Reference FASTA]
        RC[STR Repeat Catalog]
    end

    subgraph Recruitment["Recruitment Layer"]
        Contigs[Reference Contigs]
        RR[Read Recruiters<br/>Thread Pool]
        Ref[Reference Sequences<br/>Thread Pool]
        BAM_Writer[BAM Writer Task]
    end

    subgraph Analysis["Analysis Layer"]
        RCE[Repeat Catalog Entry]
        subgraph AnalysisTask["Analysis Task"]
          LR[Local Realignment]
          R[Recruited Reads]
          A[Alignments]
        end
        RSR[Repeat Site Results]
    end
    style AnalysisTask fill:#fff,stroke:#333,stroke-width:1px

    subgraph Output["Output Layer"]
        VCF[Output VCF]
        JSON[Output JSON]
        BAM_FILE[Output BAM<br/>Optional]
    end


    %% Input to Recruitment connections
    InputBAM --> Contigs
    InputBAM -->|Thread Pool| RR
    FASTA --> Ref
    Contigs -->|Thread Pool| Ref
    Contigs -.-> BAM_Writer
    BAM_Writer -.->|Write Header| BAM_FILE

    %% Recruitment to Analysis connections
    RC -->|For Each Entry| RCE
    RCE --> LR
    Ref --> LR
    RR --> R
    RCE -.->|Region Info| R

    %% Analysis internal flow
    R --> A
    LR --> A
    RCE --> A
    A --> RSR
    LR --> RSR
    A -.->|Optional| BAM_Writer

    %% Analysis to Output connections
    RSR --> VCF
    RSR --> JSON
