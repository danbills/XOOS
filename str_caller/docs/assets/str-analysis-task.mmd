graph TD
    Start[Repeat Catalog Entry] --> Step1

    subgraph Step1["1. Create Local Alignment"]
        BP["<div style='text-align:left'><b>Regions Data:</b><br/>Sequence, Type<br/><br/><b>Local Realignment Input:</b><br/>- Sequence Region Nodes<br/>- Repeats with edges to self and end flanking region node</div>"]
    end
    style BP fill:#fff,stroke:#333,stroke-width:1px,color:#333,font-size:11px,text-align:left

    Step1 --> Step2

    subgraph Step2["2. Recruit Reads from BAM"]
        Reads["<div style='text-align:left'><b>Recruited Reads:</b><br/>- Overlapping Regions<br/>- Off-target + Unmapped: if resembles repeat structure</div>"]
    end
    style Reads fill:#fff,stroke:#333,stroke-width:1px,color:#333,font-size:11px,text-align:left

    Step2 --> Step3
    BP --> Step3

    subgraph Step3["3. Align Reads"]
        Alignments["<div style='text-align:left'><b>Alignments:</b><br/>Produce multiple alignments<br/>Choose optimal repeats per read for best alignment</div>"]
    end
    style Alignments fill:#fff,stroke:#333,stroke-width:1px,color:#333,font-size:11px,text-align:left

    Alignments --> Step4
    BP --> Step4

    subgraph Step4["4. Analyze Repeat Site"]
        Classification["<div style='text-align:left'><b>Classify Read Support</b><br/>Best -> Worst:<br/>Spanning/Flanking/In-Repeat</div>"]
        Likelihood["<div style='text-align:left'><b>Calculate Log Likelihood</b><br/>for Repeat Sizes</div>"]
        Genotype["<div style='text-align:left'><b>Determine Optimal Genotype</b><br/>with Confidence Interval</div>"]
        Classification --> Likelihood
        Likelihood --> Genotype
    end
    style Classification fill:#fff,stroke:#333,stroke-width:1px,color:#333,font-size:11px,text-align:left
    style Likelihood fill:#fff,stroke:#333,stroke-width:1px,color:#333,font-size:11px,text-align:left
    style Genotype fill:#fff,stroke:#333,stroke-width:1px,color:#333,font-size:11px,text-align:left

    Genotype --> Result[Repeat Site Results]
