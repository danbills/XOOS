graph TD
  B1["Alignment Blueprint<br/>Left Flank<br/>...GCTGCTGCTGCT"]
  B2["Alignment Blueprint<br/>Repeat Unit<br/>(CAG)*"]
  B3["Alignment Blueprint<br/>Right Flank<br/>CAACAGCCGCCA..."]

  B1 --> B2 --> B3

  B1 -.->|convert| N1
  B2 -.->|convert| N2
  B3 -.->|convert| N3

  N1["Node 1: Left Flank<br/>Type: Flanking<br/>Seq: ...GCTGCTGCTGCT"]
  N2["Node 2: Repeat<br/>Type: Repeat<br/>Unit: CAG"]
  N3["Node 3: Right Flank<br/>Type: Flanking<br/>Seq: CAACAGCCGCCA..."]

  N1 -->|next| N2
  N2 -->|self-loop<br/>repeat cycle| N2
  N2 -->|end repeat| N3
  N1 -.->|skip repeat| N3

 style N1 fill:#e1f5ff,stroke:#333,stroke-width:2px,color:#333
 style N2 fill:#fff4e1,stroke:#333,stroke-width:2px,color:#333
 style N3 fill:#e1f5ff,stroke:#333,stroke-width:2px,color:#333
 style B1 fill:#f0f0f0,stroke:#666,stroke-width:1px,color:#333
 style B2 fill:#f0f0f0,stroke:#666,stroke-width:1px,color:#333
 style B3 fill:#f0f0f0,stroke:#666,stroke-width:1px,color:#333
