graph TD
    subgraph Input["Inputs"]
        LRInput["Local Alignment <br/>from Step 1"]
        RecruitedReads["Recruited Reads <br/>from Step 2"]
    end

    RecruitedReads --> AlignProcess
    LRInput --> AlignProcess

    subgraph AlignProcess["Alignment Process"]
        direction TB
        ForEachRead["For Each Read"]

        subgraph PathGen["Generate Possible Paths"]
            direction TB
            Path1["Path 1: LF → R → R → R → RF<br/>Visit repeat 3 times"]
            Path2["Path 2: LF → R → R → RF<br/>Visit repeat 2 times"]
            Path3["Path 3: LF → RF<br/>Skip repeat"]
            PathN["Path N: Other combinations"]
        end

        ForEachRead --> PathGen

        ScorePaths["Score Each Path:<br/>• Match quality per node<br/>• Alignment metrics<br/>• Visit counts for repeat nodes"]
        PathGen --> ScorePaths

        IntersectPaths["Intersect Alignment Paths:<br/>• Find common paths<br/>• If no common path exists,<br/>  return first/best path"]
        ScorePaths --> IntersectPaths

        SelectOptimal["Select Optimal Alignment<br/>for Read"]
        IntersectPaths --> SelectOptimal
    end

    style ForEachRead fill:#fff,stroke:#333,stroke-width:1px,color:#333
    style ScorePaths fill:#fff,stroke:#333,stroke-width:1px,color:#333
    style IntersectPaths fill:#fff,stroke:#333,stroke-width:1px,color:#333
    style SelectOptimal fill:#fff,stroke:#333,stroke-width:1px,color:#333
    style Path1 fill:#e8f5e9,stroke:#4caf50,stroke-width:2px,color:#333
    style Path2 fill:#fff3e0,stroke:#ff9800,stroke-width:2px,color:#333
    style Path3 fill:#ffebee,stroke:#f44336,stroke-width:2px,color:#333
    style PathN fill:#f5f5f5,stroke:#9e9e9e,stroke-width:1px,color:#333
