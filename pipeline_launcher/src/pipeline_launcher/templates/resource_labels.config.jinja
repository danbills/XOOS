// Auto-generated by the pipeline launcher.
// Applies resource labels to all Nextflow-spawned jobs for cost tracking.
// GCP label values: lowercase [a-z0-9_-], max 63 chars, may be empty.
process.resourceLabels = {
    [
        'user': '{{ user }}',
        'analysis-name': '{{ analysis_name }}',
        'nf_task_process': task.process.toString().toLowerCase().replaceAll('[^a-z0-9_-]', '-').take(63).replaceAll('^[-]+|[-]+$', ''),
        'nf_task_attempt': task.attempt.toString(),
        'nf_task_cpus': task.cpus.toString(),
        'nf_task_memory': task.memory.toString().toLowerCase().replaceAll('[^a-z0-9_-]', '-').take(63).replaceAll('^[-]+|[-]+$', ''),
        'nf_task_hash': "${task.hash[0..1]}-${task.hash[2..7]}".toString(),
    ]
}
