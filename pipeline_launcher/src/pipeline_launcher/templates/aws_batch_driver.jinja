#!/bin/bash
set -eu -o pipefail

# Add AWS CLI to PATH.
export PATH="{{ data.cliDir }}:$PATH"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

retry() {
    # Retry a command up to 3 times with exponential backoff.
    local attempt=0 max=3 delay=5
    while true; do
        attempt=$((attempt + 1))
        "$@" && return 0
        if [[ $attempt -ge $max ]]; then
            echo "[driver] WARN: '$*' failed after $max attempts"
            return 1
        fi
        echo "[driver] WARN: '$*' failed (attempt $attempt/$max), retrying in ${delay}s..."
        sleep "$delay"
        delay=$((delay * 3))
    done
}

rotate_remote() {
    # If the destination already exists, rename it with an incrementing
    # index following the Nextflow convention (.1, .2, …).
    local dst="$1"
    if aws s3 ls "$dst" 2>/dev/null | grep -q .; then
        local idx=1
        while aws s3 ls "${dst}.${idx}" 2>/dev/null | grep -q .; do
            idx=$((idx + 1))
        done
        retry aws s3 mv "$dst" "${dst}.${idx}" --quiet
    fi
}

upload_debug_log() {
    if [[ -f ".nextflow.log" ]]; then
        rotate_remote '{{ data.debugLogPath }}'
        retry aws s3 cp .nextflow.log '{{ data.debugLogPath }}' --quiet --content-type text/plain
    fi
}

upload_run_log() {
    if [[ -f "nextflow-run.log" ]]; then
        rotate_remote '{{ data.runLogPath }}'
        retry aws s3 cp nextflow-run.log '{{ data.runLogPath }}' --quiet --content-type text/plain
    fi
}

sync_nextflow_state() {
    if [[ -d ".nextflow" ]]; then
        echo '[driver] Syncing .nextflow state to {{ data.nextflowStatePath }}/ for -resume...'
        retry aws s3 sync .nextflow/ '{{ data.nextflowStatePath }}/' --quiet \
            || echo '[driver] WARN: Failed to sync .nextflow state'
    else
        echo '[driver] No .nextflow state to sync.'
    fi
}

cleanup() {
    # Upload .nextflow state (required for -resume) and logs.
    # Each step is independent — a failure in one must not prevent the others.
    sync_nextflow_state || true
    upload_debug_log || true
    upload_run_log || true
}

child_pid=""

handle_sigterm() {
    echo '[driver] Caught termination signal, forwarding to Nextflow (PID: '"${child_pid:-}"')...'
    [[ -n "${child_pid:-}" ]] && kill -INT "$child_pid" 2>/dev/null || true
    echo '[driver] Waiting for Nextflow to terminate...'
    [[ -n "${child_pid:-}" ]] && wait "$child_pid" 2>/dev/null || true
    echo '[driver] Nextflow terminated, exiting.'
    # EXIT trap fires after this, running cleanup().
    exit 143
}

trap handle_sigterm SIGTERM SIGINT
trap cleanup EXIT

# ---------------------------------------------------------------------------
# Stage configs and pipeline source
# ---------------------------------------------------------------------------

mkdir -p /pipeline/conf
{% for cfg in data.driverFetchFiles %}
retry aws s3 cp '{{ cfg.source_uri }}' '{{ cfg.container_path }}' --quiet \
    || { echo "[driver] ERROR: Failed to download config {{ cfg.container_path }}"; exit 1; }
{% endfor %}

{% if data.pipelineSourceUri is defined %}
# Download pipeline source to a secure temporary directory.
PIPELINE_DIR=$(mktemp -d)
retry aws s3 sync '{{ data.pipelineSourceUri }}/' "$PIPELINE_DIR/" --quiet \
    || { echo "[driver] ERROR: Failed to download pipeline from {{ data.pipelineSourceUri }}"; exit 1; }
echo "[driver] Downloaded pipeline to $PIPELINE_DIR"
{% endif %}

# Restore previous .nextflow state for -resume (no-op on first run when
# the remote prefix does not yet exist).
if aws s3 ls '{{ data.nextflowStatePath }}/' 2>/dev/null | grep -q .; then
    echo "[driver] Restoring .nextflow state from {{ data.nextflowStatePath }}/ for -resume..."
    retry aws s3 sync '{{ data.nextflowStatePath }}/' .nextflow/ --quiet \
        || echo "[driver] WARN: Failed to restore .nextflow state, starting fresh"
else
    echo "[driver] No previous .nextflow state found at {{ data.nextflowStatePath }}/, starting fresh."
fi

# ---------------------------------------------------------------------------
# Run Nextflow
# ---------------------------------------------------------------------------

export PYTHONUNBUFFERED=1
export NXF_OPTS="-Xms512m -Xmx2g"
export NXF_ANSI_LOG=false
export COLUMNS=120

echo "[driver] Output directory: {{ data.outputUrl }}"
{{ data.nextflowCmd }} 2>&1 | tee nextflow-run.log &
child_pid=$!

wait "$child_pid"
exit_code=$?

echo "[driver] Nextflow exited with code: $exit_code"
# EXIT trap runs cleanup() automatically.
exit "$exit_code"
